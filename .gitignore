# Python
__pycache__/
*.py[cod]
*.pyd
*.so
*.dylib
*.dll
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
.mypy_cache/
.pyre/
.ruff_cache/

# Virtualenvs
.venv/
venv/

# Build artifacts
build/
dist/
wheelhouse/

# Rust/Cargo
/target/

# Cython
*.c
# ...but vendor/ holds libsecp256k1's real C sources, not Cython output -- the rule
# above would silently drop them and break the secp256k1 extension.
!vendor/**/*.c

# macOS
.DS_Store

# IDE
.vscode/
.idea/